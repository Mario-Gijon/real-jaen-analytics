# Supply this file as the protected GitLab File variable ENV_POSTGRESQL_PROD.
# The GID must be provisioned and confirmed by SINBAD² administration; do not guess it.
PG_PROJECT_NAME=real-jaen-analytics-sinbad2-prod
PG_NETWORK_NAME=rja-sinbad2-prod-postgresql-private
PG_VOLUME_NAME=rja-sinbad2-postgresql-data
PG_SECRET_DIR=${RJA_DEPLOY_ROOT:?Set by the deployment job}/shared/postgresql/secrets
PG_TASK_IMAGE_TAG=prod
RJ_PROD_SPORTS_OPERATIONAL_VOLUME=rja-sinbad2-sports-operational-state
RJ_PROD_VIDEO_OPERATIONAL_VOLUME=rja-sinbad2-video-operational-state
# Replace with the administrator-provisioned numeric group ID before deployment.
RJ_APP_SECRET_GID=REPLACE_WITH_ADMIN_PROVISIONED_GID
