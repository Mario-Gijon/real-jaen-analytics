# GitLab deployment can later provide these values from its protected ENV_PROD file.
# Store the referenced secret files outside the repository under the deployment root.
PG_PROJECT_NAME=rja-postgresql-prod
PG_NETWORK_NAME=rja-postgresql-prod-private
PG_VOLUME_NAME=rja-postgresql-prod-data
PG_SECRET_DIR=${RJA_DEPLOY_ROOT:?}/shared/secrets/current/postgresql/prod
PG_TASK_IMAGE_TAG=prod
