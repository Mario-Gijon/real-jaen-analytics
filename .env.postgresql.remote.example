# Use only after the remote PostgreSQL operator confirms routes, firewall and TLS.
# Each URL file must use its matching app role/database and enforce verified TLS.
# Store both files outside Git with mode 0600, then apply private-group access
# with scripts/prepare-postgresql-app-secrets.sh. No owner or administrator URL.
RJ_DEV_PROJECT_NAME=real-jaen-analytics-postgresql-remote
RJ_DEV_VOLUME_PREFIX=rja-dev-postgresql-remote
RJ_REMOTE_DATABASE_SECRET_DIR=${HOME}/.local/share/real-jaen-analytics/postgresql/remote
RJ_APP_SECRET_GID=1000
# Independent local SQLite Acquisition settings.
RJ_DEV_SECRET_DIR=${HOME}/.local/share/real-jaen-analytics/dev-secrets
RJ_DEV_IMPORT_DIR=${HOME}/.local/share/real-jaen-analytics/imports
# These legacy variables still need values during Compose interpolation, even
# though the PostgreSQL overlay removes their mounts from both app containers.
RJ_DEV_SEED_DIR=${HOME}/.local/share/real-jaen-analytics/seed
RJ_DEV_VIDEO_CATALOG_DIR=${HOME}/.local/share/real-jaen-analytics/video-data
