# Stable installation identity. Use this exact project and volume set for every release.
COMPOSE_PROJECT_NAME=real-jaen-analytics-sinbad2-prod
RJ_PROD_NETWORK_PREFIX=rja-sinbad2-prod
RJ_PROD_SPORTS_STATE_VOLUME=rja-sinbad2-sports-state
RJ_PROD_ACQUISITION_PROFILES_VOLUME=rja-sinbad2-acquisition-profiles
RJ_PROD_ACQUISITION_JOBS_VOLUME=rja-sinbad2-acquisition-jobs
RJ_PROD_VIDEO_STATE_VOLUME=rja-sinbad2-video-state

RJ_DASHBOARD_IMAGE=local/real-jaen-analytics/dashboard:prod
RJ_SPORTS_DATA_IMAGE=local/real-jaen-analytics/sports-data:prod
RJ_ACQUISITION_IMAGE=local/real-jaen-analytics/acquisition:prod
RJ_VIDEO_SERVICE_IMAGE=local/real-jaen-analytics/video-service:prod
RJ_SCRAPER_RUNTIME_IMAGE=local/rj-browser-runtime:audited

RJ_DASHBOARD_BIND=127.0.0.1
RJ_DASHBOARD_PORT=33302
RJ_PROD_SECRET_DIR=/etc/real-jaen-analytics/secrets
RJ_IMPORT_DIR=/srv/real-jaen-analytics/imports
RJ_VIDEO_CATALOG_DIR=/srv/real-jaen-analytics/video-catalog
RJ_VIDEO_MANIFEST=videos.json
RJ_UPDATE_RECIPE=sofascore-group2-2627-v1
RJ_ACQUISITION_ENABLE_REAL=0
RJ_ACQUISITION_MAX_ATTEMPTS=48
RJ_ACQUISITION_MAX_SENDS=52
RJ_UPDATE_RECENT_ROUNDS=3
RJ_UPDATE_MAX_TOTAL_SENDS=50
