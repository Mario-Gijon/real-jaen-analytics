# Version every component independently; replace the example registry with the deployment registry.
RJ_DASHBOARD_IMAGE=registry.example.org/real-jaen-analytics/dashboard:0.1.0
RJ_SPORTS_DATA_IMAGE=registry.example.org/real-jaen-analytics/sports-data:0.1.0
RJ_ACQUISITION_IMAGE=registry.example.org/real-jaen-analytics/acquisition:0.1.0
RJ_VIDEO_SERVICE_IMAGE=registry.example.org/real-jaen-analytics/video-service:0.1.0

RJ_PROD_SPORTS_STATE_VOLUME=rja-prod-sports-state
RJ_PROD_ACQUISITION_PROFILES_VOLUME=rja-prod-acquisition-profiles
RJ_PROD_ACQUISITION_JOBS_VOLUME=rja-prod-acquisition-jobs
RJ_PROD_VIDEO_STATE_VOLUME=rja-prod-video-state

RJ_DASHBOARD_BIND=0.0.0.0
RJ_DASHBOARD_PORT=3000
RJ_PROD_SECRET_DIR=/etc/real-jaen-analytics/secrets
RJ_IMPORT_DIR=/srv/real-jaen-analytics/imports
RJ_VIDEO_CATALOG_DIR=/srv/real-jaen-analytics/video-catalog
RJ_VIDEO_MANIFEST=videos.json
RJ_UPDATE_RECIPE=sofascore-group2-2627-v1
RJ_ACQUISITION_ENABLE_REAL=0
RJ_ACQUISITION_MAX_ATTEMPTS=48
RJ_ACQUISITION_MAX_SENDS=52
RJ_UPDATE_RECENT_ROUNDS=3
RJ_UPDATE_MAX_TOTAL_SENDS=50
