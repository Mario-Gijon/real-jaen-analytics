# Use this content for the protected GitLab File variable ENV_PROD. Never commit private .env.prod.
# Keep these names stable when updating an existing installation.
COMPOSE_PROJECT_NAME=real-jaen-analytics-sinbad2-prod
RJ_PROD_NETWORK_PREFIX=rja-sinbad2-prod
RJ_PROD_ACQUISITION_PROFILES_VOLUME=rja-sinbad2-acquisition-profiles
RJ_PROD_ACQUISITION_JOBS_VOLUME=rja-sinbad2-acquisition-jobs

RJ_DASHBOARD_BIND=127.0.0.1
RJ_DASHBOARD_PORT=8090
RJ_PROD_SECRET_DIR=${RJA_DEPLOY_ROOT:?Set by the deployment job}/shared/secrets/current
RJ_IMPORT_DIR=${RJA_DEPLOY_ROOT:?Set by the deployment job}/shared/imports
RJ_VIDEO_CATALOG_DIR=${RJA_DEPLOY_ROOT:?Set by the deployment job}/shared/video-catalog
RJ_ACQUISITION_ENABLE_REAL=1
