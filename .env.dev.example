# Copy the private .env.dev supplied for this installation. Values here are paths/settings,
# not passwords or tokens. Existing rja-dev-* volumes are kept by compose.dev.yaml.
RJ_DEV_DASHBOARD_PORT=33201
RJ_DEV_SECRET_DIR=/home/your-user/.config/real-jaen-analytics/secrets
RJ_DEV_IMPORT_DIR=/srv/real-jaen-analytics-dev/imports-copy
RJ_DEV_VIDEO_CATALOG_DIR=/home/your-user/.config/real-jaen-analytics/video-data
RJ_DEV_VIDEO_MANIFEST=videos.json
RJ_ACQUISITION_ENABLE_REAL=0
