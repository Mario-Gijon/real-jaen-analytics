# The private installation package supplies these paths, passwords, tokens and the data seed.
# This example is intentionally incomplete; it contains no operational data or credentials.
RJ_DEV_DASHBOARD_PORT=33201
RJ_DEV_PROJECT_NAME=real-jaen-analytics-dev
RJ_DEV_VOLUME_PREFIX=rja-dev
RJ_DEV_SECRET_DIR=./.rja-private/secrets
RJ_DEV_IMPORT_DIR=./.rja-private/imports
RJ_DEV_VIDEO_CATALOG_DIR=./.rja-private/video-data
RJ_DEV_SEED_DIR=./.rja-private/seed
RJ_DEV_VIDEO_MANIFEST=videos.json
RJ_ACQUISITION_ENABLE_REAL=0
