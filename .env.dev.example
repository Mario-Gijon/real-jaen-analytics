# Development-only values. Use copies of all state and import data; keep them separate from any active installation.
RJ_DEV_DASHBOARD_PORT=33201
RJ_DEV_SECRET_DIR=/absolute/path/outside-this-repository/real-jaen-analytics-dev-secrets
RJ_DEV_IMPORT_DIR=/absolute/path/to/a-copy-of-import-files
RJ_UPDATE_RECIPE=sofascore-group2-2627-v1
RJ_UPDATE_RECENT_ROUNDS=3
RJ_UPDATE_MAX_TOTAL_SENDS=50
RJ_ACQUISITION_ENABLE_REAL=0
RJ_ACQUISITION_MAX_ATTEMPTS=48
RJ_ACQUISITION_MAX_SENDS=52
RJ_SCRAPER_RUNTIME_IMAGE=local/rj-browser-runtime:required
