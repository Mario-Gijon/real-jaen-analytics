# Copy outside the repository, then set PG_SECRET_DIR to a protected directory.
PG_PROJECT_NAME=rja-postgresql-dev
PG_NETWORK_NAME=rja-postgresql-dev-private
PG_VOLUME_NAME=rja-postgresql-dev-data
PG_SECRET_DIR=${HOME}/.local/share/real-jaen-analytics/postgresql/dev
PG_LOCAL_PORT=55432
PG_ADMIN_SPORTS_IMAGE_TAG=postgresql-admin-sports
PG_ADMIN_VIDEO_IMAGE_TAG=postgresql-admin-video
RJ_DEV_IMAGE_TAG=postgresql-dev
# Optional independent runtime tags; otherwise each service inherits RJ_DEV_IMAGE_TAG.
# RJ_DEV_SPORTS_IMAGE_TAG=postgresql-dev-sports
# RJ_DEV_ACQUISITION_IMAGE_TAG=postgresql-dev-acquisition
# RJ_DEV_VIDEO_IMAGE_TAG=postgresql-dev-video
# RJ_DEV_DASHBOARD_IMAGE_TAG=postgresql-dev-dashboard
# Replace with the private primary GID printed by prepare-postgresql-app-secrets.sh.
RJ_APP_SECRET_GID=1000
