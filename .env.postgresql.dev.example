# Copy outside the repository, then set PG_SECRET_DIR to a protected directory.
PG_PROJECT_NAME=rja-postgresql-dev
PG_NETWORK_NAME=rja-postgresql-dev-private
PG_VOLUME_NAME=rja-postgresql-dev-data
PG_SECRET_DIR=${HOME}/.local/share/real-jaen-analytics/postgresql/dev
PG_LOCAL_PORT=55432
PG_TASK_IMAGE_TAG=dev
